bool pow_2(ll n){
    if(n == 0) return true;
    return ((n > 0)&&(n & (n - 1)) == 0);
}
ll n;
void solve(){
    cin >> n;
    vector<ll> a(n);
    ll sum = 0;
    for(ll i = 0;i<n;++i) cin >> a[i],sum += a[i];
    for(ll i = 0;i<n;++i) a[i] = 2*(i+1) - a[i];
    ll temp_sum = 0;
    ll max_sum = a[0];
    for(ll i = 0;i<n;++i){
        temp_sum = max(temp_sum+a[i],a[i]);
        max_sum = max(max_sum,temp_sum);
    }
    cout << sum + max_sum << '\n';
}
