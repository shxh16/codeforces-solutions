            if((mai_xor^a[i]^b[i]) > (ajisai_xor^a[i]^b[i])){
                mai_xor = mai_xor^a[i]^b[i];
                ajisai_xor = ajisai_xor^a[i]^b[i];
            }
        }
        else{
            if((mai_xor^a[i]^b[i]) < (ajisai_xor^a[i]^b[i])){
                mai_xor = mai_xor^a[i]^b[i];
                ajisai_xor = ajisai_xor^a[i]^b[i];
            }
        }
    }
